# MoodTide API settings. Copy this file to ".env" in the same folder and fill in real values.
# Never commit the real .env file.

PORT=4000
# Addresses of your website, comma separated, no trailing slash (the Vite dev server runs on 5173)
CLIENT_ORIGIN=http://localhost:5173
# Set to "production" on the hosted server
# NODE_ENV=production

# --- Database: local Docker PostgreSQL (use the POSTGRES_PASSWORD from the project root .env)
DB_SERVER=localhost
DB_PORT=5432
DB_NAME=moodtide
DB_USER=moodtide
DB_PASSWORD=fatima
# --- or one connection string for a hosted database (A28); when set it is used instead of the DB_* lines
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true

# --- Login tokens: at least 32 random characters. The server refuses to start without it.
# Create one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste-a-long-random-string-here

# --- Importer scripts
YOUTUBE_API_KEY=
LASTFM_API_KEY=
JAMENDO_CLIENT_ID=your-jamendo-client-id